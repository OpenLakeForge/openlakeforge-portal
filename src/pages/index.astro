---
import "@fontsource/instrument-serif/400.css";
import "@fontsource/instrument-serif/400-italic.css";
import "@fontsource-variable/space-grotesk";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/tokens.css";
import "../styles/global.css";

import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import StageSection from "../components/StageSection.astro";
import Footer from "../components/Footer.astro";
import { loadRoutes, sections } from "../lib/routes";

const routes = loadRoutes();
const stages = sections(routes);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <title>OpenLakeForge</title>
  </head>
  <body>
    <Header />
    <Hero routeCount={Object.keys(routes).length} />
    <main class="wrap">
      {stages.map((section) => <StageSection section={section} />)}
    </main>
    <Footer />
  </body>
</html>
