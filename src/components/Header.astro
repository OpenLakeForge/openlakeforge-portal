---
import Mark from "./Mark.astro";

interface Props {
  signOut?: string;
}
const { signOut } = Astro.props;
---

<header>
  <div class="wrap">
    <Mark />
    <span class="wordmark">Open<span>Lake</span>Forge</span>
    <span class="label pill">Platform portal</span>
    {signOut && <a class="sign-out label" href={signOut}>Sign out</a>}
  </div>
</header>

<style>
  header { border-bottom: 1px solid var(--olf-border-subtle); }
  .wrap {
    display: flex;
    align-items: center;
    gap: var(--olf-space-4);
    padding-top: var(--olf-space-5);
    padding-bottom: var(--olf-space-5);
  }
  .wordmark {
    font: 700 var(--olf-text-h4) / 1 var(--olf-font-heading);
    letter-spacing: -0.01em;
  }
  .wordmark span { color: var(--olf-highlight); }
  .pill {
    border: 1px solid var(--olf-border-default);
    border-radius: var(--olf-radius-sm);
    padding: 0.2rem var(--olf-space-2);
    font-size: 0.6875rem;
  }
  .sign-out {
    margin-left: auto;
    color: var(--olf-link);
    border: 1px solid var(--olf-border-default);
    border-radius: var(--olf-radius-sm);
    padding: 0.2rem var(--olf-space-2);
    font-size: 0.6875rem;
  }
  .sign-out:hover { border-color: var(--olf-accent); }
</style>
